{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Theseus evidence graph case",
  "type": "object",
  "required": ["schema_version", "case_id", "label", "outcome_class", "sources", "nodes", "edges"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "1.0"},
    "case_id": {"type": "string", "minLength": 1},
    "label": {"type": "string", "minLength": 1},
    "outcome_class": {"enum": ["successful", "failed_or_inconclusive"]},
    "notes": {"type": "string"},
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "kind", "locator"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "kind": {"enum": ["primary", "expert_exposition", "formal_artifact", "historical_record"]},
          "locator": {"type": "string", "minLength": 1},
          "note": {"type": "string"}
        }
      }
    },
    "nodes": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["id", "label", "role"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "label": {"type": "string", "minLength": 1},
          "role": {"enum": ["problem", "reformulation", "reduction", "bridge_theorem", "construction", "invariant", "repair", "verification", "consequence", "analogy"]}
        }
      }
    },
    "edges": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["source", "target", "role", "evidence", "source_refs"],
        "additionalProperties": false,
        "properties": {
          "source": {"type": "string", "minLength": 1},
          "target": {"type": "string", "minLength": 1},
          "role": {"enum": ["depends_on", "reduces_to", "bridges", "constructs", "repairs", "verifies", "implies", "analogy"]},
          "evidence": {"enum": ["kernel_checked", "established_theorem", "primary_exposition", "historical_record", "analogy_only", "unknown"]},
          "source_refs": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
        }
      }
    }
  }
}
