#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/../.."
export PYTHONDONTWRITEBYTECODE=1

echo '== registry contract =='
python3 tools/check_registry.py validate

echo '== registry projections =='
python3 tools/check_registry.py render --check

echo '== unit tests =='
python3 -m unittest discover -s tests -v

echo '== whitespace =='
base_ref="${QA_BASE_REF:-origin/main}"
if ! git rev-parse --verify --quiet "$base_ref^{commit}" >/dev/null; then
  echo "QA base ref unavailable: $base_ref" >&2
  echo "Set QA_BASE_REF to the branch base commit/ref." >&2
  exit 2
fi
base_commit=$(git merge-base "$base_ref" HEAD)
git diff --check "$base_commit"..HEAD
git diff --cached --check
git diff --check

echo '== untracked whitespace =='
bad=0
while IFS= read -r -d '' path; do
  set +e
  output=$(git diff --no-index --check /dev/null "./$path" 2>&1)
  rc=$?
  set -e
  if [ "$rc" -gt 1 ]; then
    printf '%s\n' "$output"
    bad=1
  fi
done < <(git ls-files --others --exclude-standard -z)
test "$bad" -eq 0

echo DEV_CHECK_PASS
